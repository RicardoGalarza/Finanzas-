# Copia este archivo a mail.env y completa tus credenciales.
# Luego, en PowerShell, antes de levantar el backend:
#   Get-Content .\mail.env | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -match '^\s*$') { return }
#     $k,$v = $_.Split('=',2); Set-Item -Path "Env:$k" -Value $v
#   }
#   mvn quarkus:dev

MAIL_MODE=smtp
MAIL_MOCK=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=FlujoClaro <tu-correo@gmail.com>
MAIL_USERNAME=tu-correo@gmail.com
# Para Gmail: usa una "Contraseña de aplicaciones" (no tu clave normal)
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
FRONTEND_URL=http://localhost:5173
